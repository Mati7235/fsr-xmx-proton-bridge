#!/usr/bin/env bash
set -euo pipefail

resolve_self() {
  local path="$1" dir target
  case "$path" in
    */*) ;;
    *) path="$(command -v -- "$path" 2>/dev/null || printf '%s' "$path")" ;;
  esac
  while [ -L "$path" ]; do
    dir="$(cd "$(dirname "$path")" && pwd -P)"
    target="$(readlink "$path")"
    case "$target" in
      /*) path="$target" ;;
      *) path="$dir/$target" ;;
    esac
  done
  dir="$(cd "$(dirname "$path")" && pwd -P)"
  printf '%s/%s' "$dir" "$(basename "$path")"
}

SELF="$(resolve_self "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF")"
. "$SELF_DIR/lib/common.sh"

usage() {
  cat <<'EOF'
fsr-xmx: runs FSR 4 on the XMX units of Intel Arc GPUs, without touching the system.

Usage:
  fsr-xmx doctor [<game-folder>] [--profile <game>]
      Checks everything and changes nothing.

  fsr-xmx install --from <folder>
      Installs the ready-made package found in that folder.

  fsr-xmx install-compat-tool --ge-dir <GE-Proton folder>
      Creates the "GE-Proton-XMX" tool so you can pick it in Steam.

  fsr-xmx enable <game-folder> --fsr4 int8|lite [--fg xefg|anr]
                 [--mod-dll <file>] [--original-dll <file>]
                 [--optiscaler <file>] [--anr <zip>] [--profile <game>]
      Sets up a game and tells you what to paste into Steam.

  fsr-xmx disable <game-folder>
      Puts the game back the way it was.

  fsr-xmx run [--profile <game>] [--trace] -- <command...>
      Steam uses this: it loads the environment and starts the game.

  fsr-xmx uninstall
      Deletes only what this program installed.

Useful variables (advanced): FSR_XMX_HOME, FSR_XMX_CACHE, FSR_XMX_STEAM.
None of this asks for sudo or touches Steam, the system drivers or the Proton prefixes (each game's private Windows folder).
EOF
}

usage_install() {
  cat <<'EOF'
Usage: fsr-xmx install --from <folder>

The folder must contain SHA256SUMS, MANIFEST, icd/intel_icd.json,
lib/libvulkan_intel.so, igdext64.dll, cabinet.dll, tools/cm-compile.sh and
vkd3d-proton/x86_64-windows/{d3d12,d3d12core}.dll.
Without --from there is no download yet: no versions have been published.
EOF
}

usage_enable() {
  cat <<'EOF'
Usage: fsr-xmx enable <game-folder> --fsr4 int8|lite [--fg xefg|anr]
                    [--mod-dll <file>] [--original-dll <file>]
                    [--optiscaler <file>] [--anr <zip>] [--profile <game>]

  --fsr4 int8|lite    Model to use (int8 = 4.1.2X, lite = 4.1.2X Lite).
  --fg xefg|anr       Frame generation (default: xefg).
  --mod-dll           The FSR4 XMX 4.1.2 mod DLL (you provide it).
  --original-dll      Official AMD fsr-original.dll 4.1.2 (you provide it).
  --optiscaler        The official OptiScaler file (.7z or .zip), if the
                      game doesn't have it yet.
  --anr               The ANR add-on zip, only if you choose --fg anr.
EOF
}

cmd_version() {
  say "fsr-xmx (experimental installer)"
}

preflight_warnings() {
  local card driver
  if card="$(intel_card_dir)"; then
    driver="$(card_driver "$card" || true)"
    case "$driver" in
      xe) ;;
      i915) warn "the Linux kernel uses the old i915 driver; with Xe2, xe is the better one." ;;
      "") warn "couldn't read the GPU driver. Check with: lspci -k | grep -A3 VGA" ;;
      *) warn "unexpected GPU driver: $driver (expected xe or i915)." ;;
    esac
  else
    warn "no Intel GPU found. This bridge needs an Intel Arc or Xe2 card."
  fi
  if ! has_vulkan_loader; then
    warn "couldn't find the Vulkan loader. Install it: sudo pacman -S vulkan-icd-loader"
  fi
  if [ -z "$(steam_root)" ]; then
    if [ -d "$(flatpak_steam_dir)" ]; then
      warn "you have the Flatpak version of Steam, which this version doesn't support. Use the native Steam install."
    else
      warn "couldn't find Steam; open Steam once before playing."
    fi
  fi
}

download_release() {
  local base="${FSR_XMX_RELEASE_URL:-https://github.com/OWNER/fsr-xmx/releases/download}"
  local pattern="$base/%s/fsr-xmx-%s.tar.xz"
  say "Download from GitHub Releases: no versions have been published yet."
  say "(planned pattern: $pattern)"
  say "For now, install from a local folder:"
  say "  $(launch_tool) install --from <folder with SHA256SUMS>"
  return 1
}

cmd_install() {
  local from="" version=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="${2-}"; shift 2 ;;
      --from=*) from="${1#*=}"; shift ;;
      --version) version="${2-}"; shift 2 ;;
      --version=*) version="${1#*=}"; shift ;;
      -h|--help) usage_install; return 0 ;;
      *) die "unknown option for install: $1 (see: fsr-xmx install --help)" ;;
    esac
  done

  if [ -z "$from" ]; then
    download_release || return 1
  fi
  [ -d "$from" ] || die "folder not found: $from"
  from="$(cd "$from" && pwd -P)"
  [ -f "$from/SHA256SUMS" ] || die "that folder has no SHA256SUMS file, so I can't verify the files. Nothing was installed."

  version="${version:-$(manifest_get "$from" VERSION || true)}"
  [ -n "$version" ] || version="$(basename "$from")"
  case "$version" in
    *[!A-Za-z0-9._-]*) die "the version name '$version' has unusual characters; pass --version <name>" ;;
  esac

  preflight_warnings
  say "Checking $from ..."
  if ! verify_bundle "$from"; then
    die "the folder failed the check; nothing was copied."
  fi

  mkdir -p "$ROOT/versions" "$ROOT/profiles"
  if [ ! -f "$ROOT/$MARKER" ]; then
    printf 'fsr-xmx\n' >"$ROOT/$MARKER"
  fi

  local dest="$ROOT/versions/$version" tmp
  if [ -d "$dest" ]; then
    say "Version $version is already installed; not copying it again."
    if ! verify_bundle "$dest"; then
      die "the installed copy is damaged. Delete $dest and run install again."
    fi
  else
    tmp="$ROOT/versions/.tmp-$version-$$"
    rm -rf "$tmp"
    cp -a "$from/." "$tmp"
    if ! verify_bundle "$tmp"; then
      rm -rf "$tmp"
      die "the copy doesn't match the checksums; I deleted the copy and changed nothing."
    fi
    mv "$tmp" "$dest"
    say "Copied and verified in $dest"
  fi

  tmp="$ROOT/.current.$$"
  ln -sfn "versions/$version" "$tmp"
  mv -Tf "$tmp" "$ROOT/current"
  say "The active install is now: $version"
  say ""
  say "Next step: create the Steam tool with"
  say "  $(launch_tool) install-compat-tool --ge-dir <unzipped GE-Proton folder>"
}

cmd_install_compat_tool() {
  local ge_dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ge-dir) ge_dir="${2-}"; shift 2 ;;
      --ge-dir=*) ge_dir="${1#*=}"; shift ;;
      -h|--help)
        say "Usage: fsr-xmx install-compat-tool --ge-dir <unzipped GE-Proton folder>"
        return 0
        ;;
      *) die "unknown option for install-compat-tool: $1" ;;
    esac
  done
  [ -n "$ge_dir" ] || die "missing --ge-dir: pass the GE-Proton folder (already unzipped)."
  [ -d "$ge_dir" ] || die "folder not found: $ge_dir"
  ge_dir="$(cd "$ge_dir" && pwd -P)"

  local steam rel
  steam="$(steam_root)"
  [ -n "$steam" ] || die "couldn't find native Steam. Open Steam once or install it (sudo pacman -S steam). The Flatpak version is not supported."
  need_python
  rel="$(release_dir)"
  if [ ! -f "$rel/icd/intel_icd.json" ] || [ ! -f "$rel/vkd3d-proton/x86_64-windows/d3d12core.dll" ]; then
    die "first install the package: $(launch_tool) install --from <folder>"
  fi

  local ge_vkd3d="$ge_dir/files/lib/wine/vkd3d-proton/x86_64-windows"
  [ -f "$ge_vkd3d/d3d12core.dll" ] || die "that folder doesn't look like GE-Proton: missing files/lib/wine/vkd3d-proton/x86_64-windows/d3d12core.dll"
  [ -f "$ge_dir/proton" ] || die "that folder doesn't look like GE-Proton: the 'proton' file is missing."

  local tools_dir="$steam/compatibilitytools.d"
  local target="$tools_dir/$TOOL_NAME"
  mkdir -p "$tools_dir"
  if [ -e "$target" ] && [ ! -f "$target/.fsr-xmx-manifest" ]; then
    die "$target already exists and this program didn't create it. Move or delete it by hand and try again."
  fi
  if [ -e "$target" ]; then
    rm -rf "$target"
  fi

  say "Copying GE-Proton (fast copy if your disk supports it) ..."
  if ! cp -a --reflink=auto "$ge_dir" "$target" 2>/dev/null; then
    cp -a "$ge_dir" "$target" || die "couldn't copy $ge_dir to $target (not enough disk space?)."
  fi

  cp -p "$rel/vkd3d-proton/x86_64-windows/d3d12.dll" "$target/files/lib/wine/vkd3d-proton/x86_64-windows/d3d12.dll"
  cp -p "$rel/vkd3d-proton/x86_64-windows/d3d12core.dll" "$target/files/lib/wine/vkd3d-proton/x86_64-windows/d3d12core.dll"
  python3 "$SELF_DIR/lib/vdf.py" "$target" "$TOOL_NAME" "$TOOL_NAME" || die "couldn't write compatibilitytool.vdf"

  local base_version=""
  if [ -f "$ge_dir/version" ]; then
    base_version="$(head -1 "$ge_dir/version" || true)"
  fi
  {
    printf 'FORMAT=1\n'
    printf 'NAME=%s\n' "$TOOL_NAME"
    printf 'BASE=%s\n' "$(basename "$ge_dir")"
    printf 'BASE_VERSION=%s\n' "$base_version"
    printf 'CREATED=%s\n' "$(date +%Y-%m-%dT%H:%M:%S)"
    printf 'D3D12_SHA256=%s\n' "$(sha256_of "$target/files/lib/wine/vkd3d-proton/x86_64-windows/d3d12.dll")"
    printf 'D3D12CORE_SHA256=%s\n' "$(sha256_of "$target/files/lib/wine/vkd3d-proton/x86_64-windows/d3d12core.dll")"
  } >"$target/.fsr-xmx-manifest"

  say "Done: $target"
  say ""
  say "In Steam: game Properties → Compatibility → force"
  say "\"$TOOL_NAME\"."
  if [ -n "$base_version" ]; then
    say "(based on: $base_version; it does not follow GE-Proton updates)"
  fi
}

timestamp() { date +%Y%m%d-%H%M%S; }

quote_arg() {
  local value="$1"
  case "$value" in
    *[[:space:]]*)
      value="$(printf '%s' "$value" | sed 's/[\\"$`]/\\&/g')"
      printf '"%s"' "$value"
      ;;
    *) printf '%s' "$value" ;;
  esac
}

launch_tool() {
  if command -v fsr-xmx >/dev/null 2>&1; then
    printf 'fsr-xmx'
    return 0
  fi
  quote_arg "$SELF"
}

failure_hint() {
  local output="$1" path="$2" dir
  dir="$(dirname "$path")"
  case "$output" in
    *[Pp]ermission*|*[Pp]ermiso*|*[Dd]enegad*|*[Dd]enied*)
      printf 'permission denied; fix the permissions and run disable again'
      return 0
      ;;
    *[Bb]usy*|*[Oo]cupad*|*"resource unavailable"*)
      printf 'the file is busy; close whatever is using it and run disable again'
      return 0
      ;;
  esac
  if [ ! -w "$dir" ] || { [ -e "$path" ] && [ ! -w "$path" ]; }; then
    printf 'permission denied; fix the permissions and run disable again'
    return 0
  fi
  printf 'the file could not be changed; check it and run disable again'
}

state_set_pending() {
  local file="$1" list="$2" tmp="$1.$$"
  if grep -q '^PENDING_RESTORE=' "$file"; then
    awk -v value="$list" '
      index($0, "PENDING_RESTORE=") == 1 { print "PENDING_RESTORE=" value; next }
      { print }
    ' "$file" >"$tmp"
  else
    cat "$file" >"$tmp"
    printf 'PENDING_RESTORE=%s\n' "$list" >>"$tmp"
  fi
  mv "$tmp" "$file"
}

cmd_enable() {
  local game_arg="" profile_id="cyberpunk2077" fsr4="" fg="" mod_dll="" original_dll=""
  local optiscaler="" anr_zip=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) profile_id="${2-}"; shift 2 ;;
      --profile=*) profile_id="${1#*=}"; shift ;;
      --fsr4) fsr4="${2-}"; shift 2 ;;
      --fsr4=*) fsr4="${1#*=}"; shift ;;
      --fg) fg="${2-}"; shift 2 ;;
      --fg=*) fg="${1#*=}"; shift ;;
      --mod-dll) mod_dll="${2-}"; shift 2 ;;
      --mod-dll=*) mod_dll="${1#*=}"; shift ;;
      --original-dll) original_dll="${2-}"; shift 2 ;;
      --original-dll=*) original_dll="${1#*=}"; shift ;;
      --optiscaler) optiscaler="${2-}"; shift 2 ;;
      --optiscaler=*) optiscaler="${1#*=}"; shift ;;
      --anr) anr_zip="${2-}"; shift 2 ;;
      --anr=*) anr_zip="${1#*=}"; shift ;;
      -h|--help) usage_enable; return 0 ;;
      --*) die "unknown option: $1 (see: fsr-xmx enable --help)" ;;
      *) [ -z "$game_arg" ] || die "too many arguments: $1"; game_arg="$1"; shift ;;
    esac
  done
  [ -n "$game_arg" ] || die "missing the game folder. Example: fsr-xmx enable ~/.local/share/Steam/steamapps/common/Cyberpunk\\ 2077/bin/x64 --fsr4 int8"
  [ -d "$game_arg" ] || die "folder not found: $game_arg"
  local game_dir
  game_dir="$(cd "$game_arg" && pwd -P)"

  need_python
  load_profile "$(profile_path "$profile_id")"
  profile_id="$(basename "$PROF_FILE" .conf)"

  local exe
  exe="$(prof_get GAME_EXE)"
  [ -n "$exe" ] || die "the profile $PROF_FILE doesn't set GAME_EXE."
  [ -f "$game_dir/$exe" ] || die "$exe is not in $game_dir. Pass the folder that contains the game's .exe file (for Cyberpunk it is .../bin/x64)."
  if game_running "$exe" "$game_dir"; then
    die "the game is open ($exe). Close it and try again."
  fi

  local rel
  rel="$(release_dir)"
  if [ ! -f "$rel/igdext64.dll" ] || [ ! -f "$rel/cabinet.dll" ]; then
    die "the driver package isn't installed. Run first: $(launch_tool) install --from <folder>"
  fi

  fsr4="${fsr4:-$(prof_get FSR4_DEFAULT int8)}"
  fg="${fg:-$(prof_get FG_DEFAULT xefg)}"
  case "$fsr4" in
    int8|lite) ;;
    *) die "--fsr4 only accepts int8 or lite (got: $fsr4)." ;;
  esac
  case "$fg" in
    xefg|anr) ;;
    *) die "--fg only accepts xefg or anr (got: $fg)." ;;
  esac

  local mod_target="$game_dir/$(prof_get MOD_DLL)"
  local orig_target="$game_dir/$(prof_get FSR_ORIGINAL_DLL)"
  local mod_src="${mod_dll:-$mod_target}"
  local orig_src="${original_dll:-$orig_target}"

  check_pinned_file "$mod_src" "$(prof_get MOD_SHA256)" "$(prof_get MOD_SIZE)" \
    "FSR4 XMX 4.1.2 mod by nitec" \
    "Download it again from NexusMods and pass it with --mod-dll <file>."
  check_pinned_file "$orig_src" "$(prof_get FSR_ORIGINAL_SHA256)" "$(prof_get FSR_ORIGINAL_SIZE)" \
    "AMD's fsr-original.dll 4.1.2" \
    "Pass the official 4.1.2 DLL with --original-dll <file>."

  local dxgi="$game_dir/$(prof_get OPTISCALER_DLL)"
  local ini="$game_dir/$(prof_get OPTISCALER_INI)"
  local tmp_extract=""
  if [ ! -f "$dxgi" ]; then
    if [ -f "$game_dir/OptiScaler.dll" ]; then
      die "OptiScaler.dll is there, but the game needs it as $(prof_get OPTISCALER_DLL). The release ships the file under its release name, so rename it in the game folder with: mv OptiScaler.dll $(prof_get OPTISCALER_DLL)"
    fi
    [ -n "$optiscaler" ] || die "OptiScaler is missing ($(prof_get OPTISCALER_DLL)) in $game_dir. Download its official release and pass it with --optiscaler <file>."
    verify_archive "$optiscaler" "OptiScaler" "$(prof_get OPTISCALER_SHA256)" \
      "I won't use an unverified OptiScaler. Download the official release listed in the documentation and pass it with --optiscaler."
    tmp_extract="$(mktemp -d "${TMPDIR:-/tmp}/fsr-xmx-opti.XXXXXX")"
    extract_archive "$optiscaler" "$tmp_extract"
    local found_dxgi found_ini found_dir
    found_dxgi="$(find "$tmp_extract" -type f -name "$(prof_get OPTISCALER_DLL)" -print -quit)"
    [ -n "$found_dxgi" ] || die "the OptiScaler file doesn't contain $(prof_get OPTISCALER_DLL)."
    found_ini="$(find "$tmp_extract" -type f -name "$(prof_get OPTISCALER_INI)" -print -quit)"
    found_dir="$(find "$tmp_extract" -type d -name OptiScaler -print |
      awk -F/ '{ print NF, $0 }' | sort -n | tail -1 | cut -d' ' -f2-)"
    backup_begin "$game_dir"
    copy_with_backup "$found_dxgi" "$dxgi"
    if [ ! -f "$ini" ] && [ -n "$found_ini" ]; then
      copy_with_backup "$found_ini" "$ini"
    fi
    if [ -n "$found_dir" ] && [ ! -d "$game_dir/OptiScaler" ]; then
      tree_with_backup "$found_dir" "$game_dir/OptiScaler"
    fi
    rm -rf "$tmp_extract"
    tmp_extract=""
    say "OptiScaler copied and verified."
  fi
  [ -f "$ini" ] || die "$ini is missing. Start the game once with OptiScaler so it creates the file, or pass --optiscaler <file>."

  if [ "$fg" = "anr" ]; then
    local anr_dir="$game_dir/OptiScaler/custom/Apex Neural Rendering FG"
    if [ ! -f "$anr_dir/dlssg/nvngx_dlssg.dll" ]; then
      [ -n "$anr_zip" ] || die "you chose --fg anr but the ANR add-on is missing. Download the official zip and pass it with --anr <zip>."
      verify_archive "$anr_zip" "ANR add-on" "$(prof_get ANR_SHA256)" \
        "I won't use an unverified ANR. Download the official add-on from the release and pass it with --anr <zip>."
      tmp_extract="$(mktemp -d "${TMPDIR:-/tmp}/fsr-xmx-anr.XXXXXX")"
      extract_archive "$anr_zip" "$tmp_extract"
      local found_anr
      found_anr="$(find "$tmp_extract" -type d -name 'Apex Neural Rendering FG' -print -quit)"
      [ -n "$found_anr" ] || die "the zip doesn't contain the 'Apex Neural Rendering FG' folder."
      backup_begin "$game_dir"
      tree_with_backup "$found_anr" "$anr_dir"
      rm -rf "$tmp_extract"
      tmp_extract=""
      say "ANR add-on copied and verified."
    fi
  fi

  [ -n "$BK_DIR" ] || backup_begin "$game_dir"

  if [ "$mod_src" != "$mod_target" ] || [ ! -f "$mod_target" ]; then
    copy_with_backup "$mod_src" "$mod_target"
  fi
  if [ "$orig_src" != "$orig_target" ] || [ ! -f "$orig_target" ]; then
    copy_with_backup "$orig_src" "$orig_target"
  fi
  copy_with_backup "$rel/igdext64.dll" "$game_dir/$(prof_get IGDEXT_DLL igdext64.dll)"
  copy_with_backup "$rel/cabinet.dll" "$game_dir/$(prof_get CABINET_DLL cabinet.dll)"

  local sets
  sets="$(prof_get INI_BASE)"
  if [ "$fg" = "anr" ]; then
    sets="$sets;$(prof_get INI_FG_ANR)"
  else
    sets="$sets;$(prof_get INI_FG_XEFG)"
  fi
  local changes
  changes="$(ini_stream "$sets" | python3 "$SELF_DIR/lib/ini_edit.py" plan "$ini")"
  if [ -n "$changes" ]; then
    backup_record "$ini"
    ini_stream "$sets" | python3 "$SELF_DIR/lib/ini_edit.py" set "$ini" || die "couldn't adjust $ini"
    say "OptiScaler.ini adjusted:"
    printf '%s\n' "$changes" | sed 's/^/        /'
  else
    say "OptiScaler.ini was already set correctly."
  fi

  local appid provider keep_coopmat state_dir stamp
  appid="$(prof_get APPID)"
  case "$fsr4" in
    int8) provider="$(prof_get PROVIDER_INT8 8)" ;;
    lite) provider="$(prof_get PROVIDER_LITE 12)" ;;
  esac
  keep_coopmat=0
  if [ "$fg" = "anr" ]; then
    keep_coopmat=1
  fi

  state_dir="$ROOT/profiles/$profile_id"
  mkdir -p "$state_dir"
  local prev_backup="" prev_game=""
  if [ -f "$state_dir/state.conf" ]; then
    prev_game="$(key_get "$state_dir/state.conf" GAME_DIR || true)"
    if [ "$prev_game" = "$game_dir" ]; then
      prev_backup="$(key_get "$state_dir/state.conf" BACKUP || true)"
    fi
  fi
  stamp="$(timestamp)"
  backup_discard_if_empty
  local backup_rel=""
  if [ -n "$BK_DIR" ]; then
    backup_rel="${BK_DIR#"$game_dir"/}"
  elif [ -n "$prev_backup" ] && [ -d "$game_dir/$prev_backup" ]; then
    backup_rel="$prev_backup"
  fi
  {
    printf 'PROFILE_ID=%s\n' "$profile_id"
    printf 'GAME_NAME=%s\n' "$(prof_get GAME_NAME "$profile_id")"
    printf 'GAME_DIR=%s\n' "$game_dir"
    printf 'GAME_EXE=%s\n' "$exe"
    printf 'APPID=%s\n' "$appid"
    printf 'FSR4=%s\n' "$fsr4"
    printf 'FG=%s\n' "$fg"
    printf 'PROVIDER_INDEX=%s\n' "$provider"
    printf 'KEEP_COOPMAT=%s\n' "$keep_coopmat"
    printf 'VKD3D_DISABLE_EXTENSIONS=%s\n' "$(prof_get VKD3D_DISABLE_EXTENSIONS)"
    printf 'DLL_OVERRIDES=%s\n' "$(prof_get DLL_OVERRIDES 'dxgi cabinet')"
    printf 'RELEASE=%s\n' "$(readlink "$ROOT/current" 2>/dev/null || printf 'unknown')"
    printf 'ENABLED_AT=%s\n' "$stamp"
    printf 'BACKUP=%s\n' "$backup_rel"
  } >"$state_dir/state.conf"

  if [ -n "$BK_DIR" ]; then
    say "Backups of the files that were overwritten: $BK_DIR"
  fi

  local tool
  tool="$(launch_tool)"
  say ""
  say "Done: $(prof_get GAME_NAME "$profile_id") is ready (FSR 4 XMX $fsr4, FG: $fg)."
  say ""
  say "Paste this line into Steam → Properties → Launch Options:"
  say ""
  say "  $tool run --profile $profile_id -- %command%"
  say ""
  say "Then check with: $tool doctor $(quote_arg "$game_dir") --profile $profile_id"
}

cmd_disable() {
  local game_arg="" profile_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) profile_id="${2-}"; shift 2 ;;
      --profile=*) profile_id="${1#*=}"; shift ;;
      -h|--help)
        say "Usage: fsr-xmx disable <game-folder> [--profile <game>]"
        say ""
        say "Puts back every file that enable replaced or added, using the backup"
        say "folder inside the game. If a file can't be restored, run disable again."
        return 0
        ;;
      --*) die "unknown option: $1" ;;
      *) [ -z "$game_arg" ] || die "too many arguments: $1"; game_arg="$1"; shift ;;
    esac
  done
  [ -n "$game_arg" ] || die "missing the game folder. Example: fsr-xmx disable <folder>"
  [ -d "$game_arg" ] || die "folder not found: $game_arg"
  local game_dir
  game_dir="$(cd "$game_arg" && pwd -P)"

  local bk_root="$game_dir/.fsr-xmx-backup"
  [ -d "$bk_root" ] || die "nothing set up by fsr-xmx in $game_dir (.fsr-xmx-backup is missing)."

  local -a pending=()
  local dir
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    [ -f "$dir/manifest.tsv" ] || continue
    [ -f "$dir/applied" ] && continue
    pending+=("$dir")
  done < <(find "$bk_root" -mindepth 1 -maxdepth 1 -type d | LC_ALL=C sort)

  if [ "${#pending[@]}" -eq 0 ]; then
    die "no changes pending to undo in $game_dir (did you already run disable?)."
  fi

  local problems=0 oldest="${pending[0]}"
  local -a failed=()
  local -A failed_set=()
  local i action rel hash path dir_failed out
  for ((i = ${#pending[@]} - 1; i >= 0; i--)); do
    dir="${pending[$i]}"
    dir_failed=0
    while IFS=$'\t' read -r action rel hash; do
      case "$action" in
        replaced)
          path="$game_dir/$rel"
          if [ ! -f "$dir/files/$rel" ]; then
            failmsg "couldn't restore $rel: the backup $dir/files/$rel is missing. Put the backup back and run disable again."
            dir_failed=1
            failed+=("$rel")
            failed_set["$rel"]=1
            continue
          fi
          mkdir -p "$(dirname "$path")"
          if ! out="$(cp -p "$dir/files/$rel" "$path" 2>&1)"; then
            failmsg "couldn't restore $rel: $(failure_hint "$out" "$path")."
            dir_failed=1
            failed+=("$rel")
            failed_set["$rel"]=1
          fi
          ;;
        added)
          if ! out="$(rm -f "$game_dir/$rel" 2>&1)"; then
            failmsg "couldn't remove $rel: $(failure_hint "$out" "$game_dir/$rel")."
            dir_failed=1
            failed+=("$rel")
            failed_set["$rel"]=1
          fi
          ;;
        mkdir)
          rmdir "$game_dir/$rel" 2>/dev/null || true
          ;;
        FORMAT|GAME_DIR|CREATED) ;;
      esac
    done < <(tac "$dir/manifest.tsv")
    if [ "$dir_failed" -ne 0 ]; then
      problems=1
    fi
  done

  local verify_failed=0
  while IFS=$'\t' read -r action rel hash; do
    if [ -n "${failed_set[$rel]:-}" ]; then
      continue
    fi
    case "$action" in
      replaced)
        path="$game_dir/$rel"
        if [ ! -f "$path" ]; then
          failmsg "expected $rel to be back, but it's missing."
          verify_failed=1
          failed+=("$rel")
        elif [ -n "$hash" ] && [ "$(sha256_of "$path")" != "$hash" ]; then
          failmsg "$rel is not identical to before (different checksum)."
          verify_failed=1
          failed+=("$rel")
        fi
        ;;
      added)
        [ -e "$game_dir/$rel" ] && { failmsg "$rel should have been removed but is still there."; verify_failed=1; failed+=("$rel"); }
        ;;
    esac
  done <"$oldest/manifest.tsv"
  if [ "$verify_failed" -ne 0 ]; then
    problems=1
  fi

  local state_dir=""
  if [ -n "$profile_id" ]; then
    state_dir="$ROOT/profiles/$profile_id"
  else
    local st
    for st in "$ROOT"/profiles/*/state.conf; do
      [ -f "$st" ] || continue
      if [ "$(key_get "$st" GAME_DIR || true)" = "$game_dir" ]; then
        state_dir="$(dirname "$st")"
        break
      fi
    done
  fi

  if [ "$problems" -eq 0 ]; then
    for dir in "${pending[@]}"; do
      : >"$dir/applied"
    done
  fi

  if [ "$problems" -ne 0 ]; then
    local list
    list="$(printf '%s\n' "${failed[@]}" | awk 'NF && !seen[$0]++' | paste -sd '|' -)"
    say ""
    say "The game is still set up, because these files are not back to how they were:"
    printf '%s\n' "${failed[@]}" | awk 'NF && !seen[$0]++' | sed 's/^/  /'
    say "Run disable again to retry them: $(launch_tool) disable $(quote_arg "$game_dir")"
    if [ -n "$state_dir" ] && [ -f "$state_dir/state.conf" ]; then
      state_set_pending "$state_dir/state.conf" "$list"
      say "The state in $state_dir/state.conf stays pending."
    fi
    say "Backups are kept in $bk_root in case you want to check them by hand."
    exit 1
  fi

  if [ -n "$state_dir" ] && [ -f "$state_dir/state.conf" ]; then
    mv "$state_dir/state.conf" "$state_dir/state.conf.disabled"
    say "The game was archived as disabled in $state_dir."
  fi

  say ""
  say "Done: $game_dir is back to how it was before."
  say "Backups are kept in $bk_root (you can delete them by hand)."
  say "Remove the fsr-xmx line from the launch options in Steam."
}

resolve_run_profile() {
  local want="$1" explicit="$2"
  shift 2
  local -a command=("$@")
  local st id game appid arg matched="" count=0
  if [ -n "$explicit" ]; then
    st="$(state_file "$want")"
    [ -f "$st" ] || die "the game '$want' is not set up. Run: $(launch_tool) enable <game folder> --profile $want"
    printf '%s' "$want"
    return 0
  fi
  local -a ids=()
  for st in "$ROOT"/profiles/*/state.conf; do
    [ -f "$st" ] || continue
    id="$(basename "$(dirname "$st")")"
    count=$((count + 1))
    ids+=("$id")
    game="$(key_get "$st" GAME_DIR || true)"
    appid="$(key_get "$st" APPID || true)"
    if [ -n "$game" ]; then
      case "$PWD/" in
        "$game"/*) matched="$id"; break ;;
      esac
      for arg in "${command[@]}"; do
        case "$arg" in
          "$game"/*) matched="$id"; break ;;
        esac
      done
      [ -n "$matched" ] && break
    fi
    if [ -n "$appid" ] && { [ "${SteamAppId:-}" = "$appid" ] || [ "${SteamCompatAppId:-}" = "$appid" ]; }; then
      matched="$id"
      break
    fi
  done
  if [ -n "$matched" ]; then
    printf '%s' "$matched"
    return 0
  fi
  if [ "$count" -eq 1 ]; then
    printf '%s' "${ids[0]}"
    return 0
  fi
  if [ "$count" -eq 0 ]; then
    die "no game is set up yet. Run: $(launch_tool) enable <game folder> --fsr4 int8"
  fi
  die "several games are set up (${ids[*]}) and I don't know which one this is. Add --profile <game> to the Steam line."
}

cmd_run() {
  local want="" explicit="" trace=0 print_env=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) want="${2-}"; explicit=1; shift 2 ;;
      --profile=*) want="${1#*=}"; explicit=1; shift ;;
      --game) want="${2-}"; explicit=1; shift 2 ;;
      --game=*) want="${1#*=}"; explicit=1; shift ;;
      --trace) trace=1; shift ;;
      --print-env) print_env=1; shift ;;
      --) shift; break ;;
      -h|--help)
        say "Usage: fsr-xmx run [--profile <game>] [--trace] -- <command...>"
        say "In Steam, use it like this: $(launch_tool) run --profile cyberpunk2077 -- %command%"
        return 0
        ;;
      -*) die "unknown option for run: $1" ;;
      *) break ;;
    esac
  done

  local -a command=("$@")
  [ "${#command[@]}" -gt 0 ] || die "missing the command to run. Usage: fsr-xmx run -- %command%"

  local rel
  rel="$(release_dir)"
  if [ ! -f "$rel/icd/intel_icd.json" ]; then
    die "can't find the installed driver. Run: $(launch_tool) install --from <folder>"
  fi

  local id state
  id="$(resolve_run_profile "$want" "$explicit" "${command[@]}")"
  state="$(state_file "$id")"

  local appid game_dir exe fsr4 fg provider keep disable_ext overrides
  appid="$(key_get "$state" APPID || true)"
  game_dir="$(key_get "$state" GAME_DIR || true)"
  exe="$(key_get "$state" GAME_EXE || true)"
  fsr4="$(key_get "$state" FSR4 || true)"
  fg="$(key_get "$state" FG || true)"
  provider="$(key_get "$state" PROVIDER_INDEX || true)"
  keep="$(key_get "$state" KEEP_COOPMAT || true)"
  disable_ext="$(key_get "$state" VKD3D_DISABLE_EXTENSIONS || true)"
  overrides="$(key_get "$state" DLL_OVERRIDES || true)"
  [ -n "$appid" ] || appid="0"
  [ -n "$overrides" ] || overrides="dxgi cabinet"

  local cache_game="$CACHE/$appid"
  mkdir -p "$cache_game/kernels" "$cache_game/logs"

  export VK_DRIVER_FILES="$rel/icd/intel_icd.json"
  export VK_LOADER_LAYERS_DISABLE='*'
  export VKD3D_DISABLE_EXTENSIONS="$disable_ext"
  export ANV_CM_HELPER="$rel/tools/cm-compile.sh"
  export ANV_CM_KERNEL_DIR="$cache_game/kernels"
  export ANV_CM_DEBUG=1
  # shellcheck disable=SC2086
  export WINEDLLOVERRIDES="$(merge_dll_overrides "${WINEDLLOVERRIDES-}" $overrides)"
  export PROTON_LOG=1
  export PROTON_LOG_DIR="$cache_game/logs"
  if [ "$trace" = "1" ]; then
    export VKD3D_DEBUG=trace
  else
    export VKD3D_DEBUG="${VKD3D_DEBUG:-warn}"
  fi
  case "$fsr4" in
    int8) export FSR4_XMX_INT8=1 ;;
    lite) export FSR4_XMX_LITE=1 ;;
  esac
  if [ -n "$provider" ]; then
    export FSR4_XMX_PROVIDER_INDEX="$provider"
  fi
  if [ "$keep" = "1" ]; then
    export VKD3D_KEEP_COOPMAT_EXTENSION=1
  fi

  if [ "$print_env" = "1" ]; then
    printf 'profile: %s (%s, FSR4 %s, FG %s)\n' "$id" "$game_dir" "${fsr4:-stock}" "${fg:-off}"
    local name
    for name in VK_DRIVER_FILES VK_LOADER_LAYERS_DISABLE VKD3D_DISABLE_EXTENSIONS \
                ANV_CM_HELPER ANV_CM_KERNEL_DIR ANV_CM_DEBUG WINEDLLOVERRIDES \
                FSR4_XMX_INT8 FSR4_XMX_LITE FSR4_XMX_PROVIDER_INDEX \
                VKD3D_KEEP_COOPMAT_EXTENSION PROTON_LOG PROTON_LOG_DIR VKD3D_DEBUG; do
      if [ -n "${!name:-}" ]; then
        printf '%s=%s\n' "$name" "${!name}"
      fi
    done
    return 0
  fi

  if [ -n "$exe" ] && [ -f "$game_dir/$exe" ] && game_running "$exe" "$game_dir"; then
    say "fsr-xmx: a $exe is already running; continuing anyway (Steam usually starts only one process)."
  fi
  exec "${command[@]}"
}

cmd_doctor() {
  local game_arg="" profile_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) profile_id="${2-}"; shift 2 ;;
      --profile=*) profile_id="${1#*=}"; shift ;;
      -h|--help)
        say "Usage: fsr-xmx doctor [<game-folder>] [--profile <game>]"
        say ""
        say "Checks the hardware, the install and (if you pass a folder) the game files."
        say "Changes nothing. The exit status is non-zero only when something is wrong."
        return 0
        ;;
      --*) die "unknown option: $1" ;;
      *) [ -z "$game_arg" ] || die "too many arguments: $1"; game_arg="$1"; shift ;;
    esac
  done

  local card="" driver="" steam rel
  say "== Hardware and system =="
  if card="$(intel_card_dir)"; then
    local device
    device="$(cat "$card/device/device" 2>/dev/null || true)"
    okl "Intel GPU detected (PCI 8086:${device#0x})"
  elif command -v lspci >/dev/null 2>&1 && lspci -nn 2>/dev/null | grep -qi 'VGA.*8086:'; then
    card="lspci"
    okl "Intel GPU detected (via lspci; couldn't read /sys)"
  else
    failmsg "no Intel GPU found. This bridge needs an Intel Arc/Xe2 card. Check with: lspci -nn | grep -i vga"
  fi

  if [ -n "$card" ] && [ "$card" != "lspci" ]; then
    driver="$(card_driver "$card" || true)"
    case "$driver" in
      xe) okl "Linux kernel driver: xe" ;;
      i915) warn "Linux kernel driver: i915 (old). With Xe2, xe is the better one; if you can, update the kernel." ;;
      "") failmsg "couldn't see which driver the GPU uses. Try: lspci -k | grep -A3 -i vga" ;;
      *) warn "Linux kernel driver: $driver (expected xe or i915)." ;;
    esac
  elif [ -z "$card" ]; then
    failmsg "without an Intel GPU I can't check the driver."
  fi

  if has_vulkan_loader; then
    okl "Vulkan loader found"
  else
    failmsg "Vulkan loader not found. Install it: sudo pacman -S vulkan-icd-loader"
  fi

  if command -v python3 >/dev/null 2>&1; then
    okl "python3 found"
  else
    failmsg "python3 is missing (the installer uses it to edit the .ini file). Install it: sudo pacman -S python"
  fi

  steam="$(steam_root)"
  if [ -n "$steam" ] && [ -d "$steam" ]; then
    okl "native Steam at $steam"
  elif [ -d "$(flatpak_steam_dir)" ]; then
    warn "you have the Flatpak version of Steam, which this version doesn't support (it can't see your game folders). Use native Steam."
  else
    warn "Steam was not found, so the Steam checks were skipped. This is informational; the game files decide the result. Open Steam once and run doctor again to check them too."
  fi

  say ""
  say "== Installer =="
  rel="$(release_dir)"
  if [ -d "$ROOT" ] && [ -f "$ROOT/$MARKER" ]; then
    if [ -L "$ROOT/current" ] && [ -d "$ROOT/current" ]; then
      local detail
      if detail="$(verify_bundle "$rel" 2>&1)"; then
        okl "active install: $(readlink "$ROOT/current")"
      else
        failmsg "the active install is damaged. Install again: $(launch_tool) install --from <folder>"
        printf '%s\n' "$detail" | sed 's/^/        /'
      fi
    else
      failmsg "the link '$ROOT/current' is missing. Install again: $(launch_tool) install --from <folder>"
    fi
  else
    failmsg "the driver is not installed. Run: $(launch_tool) install --from <folder>"
  fi

  if [ -n "$steam" ] && [ -d "$steam/compatibilitytools.d" ]; then
    local man found=0 tool mismatch
    for man in "$steam"/compatibilitytools.d/*/.fsr-xmx-manifest; do
      [ -f "$man" ] || continue
      found=1
      tool="$(dirname "$man")"
      mismatch=0
      if [ -f "$rel/vkd3d-proton/x86_64-windows/d3d12core.dll" ]; then
        local want got
        want="$(sed -n 's/^D3D12CORE_SHA256=//p' "$man" | head -1)"
        got="$(sha256_of "$tool/files/lib/wine/vkd3d-proton/x86_64-windows/d3d12core.dll" 2>/dev/null || true)"
        [ "$want" = "$got" ] || mismatch=1
        want="$(sed -n 's/^D3D12_SHA256=//p' "$man" | head -1)"
        got="$(sha256_of "$tool/files/lib/wine/vkd3d-proton/x86_64-windows/d3d12.dll" 2>/dev/null || true)"
        [ "$want" = "$got" ] || mismatch=1
      fi
      if [ "$mismatch" = "0" ]; then
        okl "compatibility tool: $(basename "$tool")"
      else
        failmsg "the tool $(basename "$tool") has different DLLs than recorded. Recreate it: $(launch_tool) install-compat-tool --ge-dir <folder>"
      fi
    done
    if [ "$found" = "0" ]; then
      failmsg "no compatibility tool from this program found. Create it: $(launch_tool) install-compat-tool --ge-dir <GE-Proton folder>"
    fi
  elif [ -z "$steam" ]; then
    warn "without Steam I can't check the compatibility tool."
  fi

  if [ -n "$game_arg" ]; then
    say ""
    if ! doctor_game "$game_arg" "$profile_id"; then
      say ""
      say "Nothing else was checked for that folder."
      return 1
    fi
  else
    say ""
    say "To check a game: $(launch_tool) doctor <game-folder>"
  fi

  say ""
  if [ "$FAIL_COUNT" -eq 0 ] && [ "$GAME_NOT_ENABLED" = "1" ]; then
    say "Nothing is enabled for this game yet. Next step: $(launch_tool) enable <game-folder> --fsr4 int8"
    return 0
  fi
  if [ "$FAIL_COUNT" -eq 0 ]; then
    say "All good."
    return 0
  fi
  say "There are $FAIL_COUNT problem(s) to fix (look at the MISSING lines)."
  return 1
}

game_target_below() {
  local base="$1" want="${2-}" id exe candidate
  if [ -n "$want" ]; then
    load_profile "$(profile_path "$want")"
    exe="$(prof_get GAME_EXE)"
    candidate="$base/bin/x64/$exe"
    if [ -n "$exe" ] && [ -f "$candidate" ]; then
      printf '%s' "$(dirname "$candidate")"
      return 0
    fi
    return 1
  fi
  while IFS= read -r id; do
    load_profile "$(profile_path "$id")"
    exe="$(prof_get GAME_EXE)"
    [ -n "$exe" ] || continue
    candidate="$base/bin/x64/$exe"
    if [ -f "$candidate" ]; then
      printf '%s' "$(dirname "$candidate")"
      return 0
    fi
  done < <(profile_ids)
  if [ -d "$base/bin/x64" ]; then
    candidate="$(find "$base/bin/x64" -maxdepth 1 -type f -iname '*.exe' -print -quit)"
    if [ -n "$candidate" ]; then
      printf '%s' "$base/bin/x64"
      return 0
    fi
  fi
  return 1
}

doctor_game() {
  local game_arg="$1" profile_id="$2" game_dir exe candidate
  if [ -f "$game_arg" ]; then
    say "That is a file, not a folder. Pass the folder that contains it: $(dirname "$game_arg")"
    return 1
  fi
  [ -d "$game_arg" ] || { failmsg "game folder not found: $game_arg"; return 1; }
  game_dir="$(cd "$game_arg" && pwd -P)"

  if candidate="$(game_target_below "$game_dir" "$profile_id")"; then
    say "That folder is not the game folder. Pass this one instead: $candidate"
    return 1
  fi

  if [ -z "$profile_id" ]; then
    local id
    while IFS= read -r id; do
      load_profile "$(profile_path "$id")"
      if [ -f "$game_dir/$(prof_get GAME_EXE)" ]; then
        profile_id="$id"
        break
      fi
    done < <(profile_ids)
    if [ -z "$profile_id" ]; then
      failmsg "I don't recognize the game in $game_dir. Pass --profile <game>."
      return 1
    fi
  else
    load_profile "$(profile_path "$profile_id")"
    profile_id="$(basename "$PROF_FILE" .conf)"
  fi

  say "== $(prof_get GAME_NAME "$profile_id") ($game_dir) =="
  local rel state fsr4 fg enabled=0
  rel="$(release_dir)"
  state="$(state_file "$profile_id")"
  if [ -f "$state" ] && [ "$(key_get "$state" GAME_DIR || true)" = "$game_dir" ]; then
    fsr4="$(key_get "$state" FSR4 || true)"
    fg="$(key_get "$state" FG || true)"
    local pending
    pending="$(key_get "$state" PENDING_RESTORE || true)"
    if [ -n "$pending" ]; then
      failmsg "this game is still modified; disable could not restore these files:"
      printf '%s\n' "$pending" | tr '|' '\n' | sed 's/^/        /'
      say "Run $(launch_tool) disable $(quote_arg "$game_dir") to finish putting the game back."
      return 1
    fi
    enabled=1
    okl "set up by fsr-xmx (FSR4 $fsr4, FG $fg)"
  else
    fsr4="$(prof_get FSR4_DEFAULT int8)"
    fg="$(prof_get FG_DEFAULT xefg)"
    GAME_NOT_ENABLED=1
    warn "this game is not set up (or it was set up for another folder). Run: $(launch_tool) enable \"$game_dir\" --fsr4 $fsr4"
  fi

  local mod="$game_dir/$(prof_get MOD_DLL)"
  if [ ! -f "$mod" ]; then
    failmsg "nitec's mod ($(prof_get MOD_DLL)) is missing. Pass it with --mod-dll in enable."
  elif [ "$(sha256_of "$mod")" = "$(prof_get MOD_SHA256)" ]; then
    okl "FSR4 XMX mod: checksum correct"
  else
    failmsg "nitec's mod is not the expected 4.1.2 version. Copy it again with enable --mod-dll."
  fi

  local orig="$game_dir/$(prof_get FSR_ORIGINAL_DLL)"
  if [ ! -f "$orig" ]; then
    failmsg "fsr-original.dll is missing (the INT8/Lite weights). Pass it with enable --original-dll."
  elif [ "$(sha256_of "$orig")" = "$(prof_get FSR_ORIGINAL_SHA256)" ]; then
    okl "fsr-original.dll: checksum correct"
  else
    failmsg "fsr-original.dll is not the expected official 4.1.2 version. Get the right one and run enable again."
  fi

  if [ -f "$rel/igdext64.dll" ]; then
    local shim="$game_dir/$(prof_get IGDEXT_DLL igdext64.dll)"
    if [ ! -f "$shim" ]; then
      if [ "$enabled" = "1" ]; then
        failmsg "igdext64.dll is missing next to the game. Run enable again with the driver installed."
      else
        warn "there is no igdext64.dll next to the game yet (enable adds it)."
      fi
    elif [ "$(sha256_of "$shim")" = "$(sha256_of "$rel/igdext64.dll")" ]; then
      okl "igdext64.dll: same as the driver's"
    else
      failmsg "the game's igdext64.dll is not the driver's. Run enable again."
    fi
    local cab="$game_dir/$(prof_get CABINET_DLL cabinet.dll)"
    if [ -f "$cab" ] && [ "$(sha256_of "$cab")" = "$(sha256_of "$rel/cabinet.dll")" ]; then
      okl "cabinet.dll: same as the driver's"
    elif [ "$fg" = "anr" ]; then
      failmsg "cabinet.dll doesn't match the driver's. Run enable again."
    fi
  else
    warn "without an install I can't compare igdext64.dll or cabinet.dll."
  fi

  local ini="$game_dir/$(prof_get OPTISCALER_INI)"
  if [ ! -f "$ini" ]; then
    failmsg "$(prof_get OPTISCALER_INI) is missing. Start the game once with OptiScaler, or pass --optiscaler to enable."
  else
    if grep -q $'\r' "$ini"; then
      okl "OptiScaler.ini has Windows line endings (CRLF)"
    else
      warn "OptiScaler.ini doesn't have Windows line endings (CRLF), which OptiScaler expects. Open it and save it with CRLF line endings."
    fi
    local sets bad="" section key value got
    sets="$(prof_get INI_BASE);$(prof_get INI_FG_ANR)"
    [ "$fg" = "anr" ] || sets="$(prof_get INI_BASE);$(prof_get INI_FG_XEFG)"
    while IFS=$'\t' read -r section key value; do
      [ -n "$section" ] || continue
      got="$(python3 "$SELF_DIR/lib/ini_edit.py" get "$ini" "$section" "$key" 2>/dev/null || true)"
      if [ "$(printf '%s' "$got" | tr 'A-Z' 'a-z')" != "$(printf '%s' "$value" | tr 'A-Z' 'a-z')" ]; then
        bad="$bad [$section] $key (is '${got:-empty}', should be '$value');"
      fi
    done < <(ini_stream "$sets")
    if [ -z "$bad" ]; then
      okl "OptiScaler.ini: FSR4 and FG keys are in order"
    elif [ "$enabled" = "1" ]; then
      failmsg "OptiScaler.ini has keys with the wrong values:$bad Run enable again."
    else
      warn "OptiScaler.ini doesn't have fsr-xmx's values yet:$bad (enable writes them)."
    fi
  fi

  local appid marker
  appid="$(prof_get APPID)"
  marker="$CACHE/$appid/kernels/compile_failed.txt"
  if [ -f "$marker" ]; then
    warn "the driver gave up on some shader kernel (compile_failed.txt). Check the game log before trying again."
  fi
}

cmd_uninstall() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        say "Usage: fsr-xmx uninstall"
        say ""
        say "Deletes the driver install and the compatibility tool that this program created."
        say "It refuses while a game is still set up, so run disable for that game first."
        return 0
        ;;
      *) die "unknown option: $1" ;;
    esac
  done

  local enabled=""
  local st
  for st in "$ROOT"/profiles/*/state.conf; do
    [ -f "$st" ] || continue
    enabled="$enabled $(basename "$(dirname "$st")")"
  done
  if [ -n "$enabled" ]; then
    say "Games are still set up:$enabled"
    say "Before uninstalling, put them back the way they were with:"
    for st in $enabled; do
      local gd
      gd="$(key_get "$(state_file "$st")" GAME_DIR || true)"
      say "  $(launch_tool) disable \"$gd\""
    done
    die "I deleted nothing, so no game is left half-changed."
  fi

  local steam tool removed=0
  steam="$(steam_root)"
  if [ -n "$steam" ] && [ -d "$steam/compatibilitytools.d" ]; then
    for tool in "$steam"/compatibilitytools.d/*/; do
      [ -d "$tool" ] || continue
      if [ -f "$tool/.fsr-xmx-manifest" ]; then
        rm -rf "${tool%/}"
        say "Removed the compatibility tool $(basename "$tool")."
        removed=1
      fi
    done
  fi

  if [ -d "$ROOT" ]; then
    [ -f "$ROOT/$MARKER" ] || die "$ROOT was not created by this program (missing $MARKER); I won't delete it."
    rm -rf "$ROOT"
    say "Removed $ROOT"
    removed=1
  fi

  if [ -d "$CACHE" ]; then
    say "The shader cache is in $CACHE; delete it by hand if you want the space back."
  fi

  if [ "$removed" = "0" ]; then
    say "Found nothing installed by fsr-xmx."
  else
    say "Done. Steam, the Proton prefixes and your games were left untouched."
  fi
}

main() {
  local command="${1-}"
  if [ $# -gt 0 ]; then shift; fi
  case "$command" in
    doctor) cmd_doctor "$@" ;;
    install) cmd_install "$@" ;;
    install-compat-tool) cmd_install_compat_tool "$@" ;;
    enable) cmd_enable "$@" ;;
    disable) cmd_disable "$@" ;;
    run) cmd_run "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    version|--version|-V) cmd_version ;;
    help|--help|-h) usage ;;
    "") usage; exit 2 ;;
    *) usage >&2; die "unknown command '$command'." ;;
  esac
}

main "$@"
