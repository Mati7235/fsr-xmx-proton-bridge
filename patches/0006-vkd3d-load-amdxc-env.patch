From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: amdxc-probe research <local>
Date: Sat, 22 Nov 2026 16:55:00 +0000
Subject: [PATCH] vkd3d: Load amdxc64.dll for the ML FG gate probe (opt-in)

When VKD3D_LOAD_AMDXC=1 (any non-empty value except "0"), load
amdxc64.dll from the standard DLL search path at d3d12 device
creation, regardless of the Vulkan vendor id. The FSR frame
generation module (amd_fidelityfx_framegeneration_dx12.dll 4.0.1)
only looks the module up with GetModuleHandleA/W; it never loads it.
On Intel vkd3d's vendor hack would not load the DLL, so a local
amdxc64 shim in the prefix system32 would never be seen and the ML
frame generation gate would stay closed.

This patch only loads the library: every interface answer still
comes from the shim. The existing vendor check and its comments are
untouched; without the variable the behaviour is identical. Aimed at
a disposable prefix probe (analysis/fg-401-static/p0-gate-probe.md),
not for installation in a Proton build.

diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -3145,6 +3145,20 @@
     return S_OK;
 }
 
+static bool vkd3d_load_amdxc_probe_enabled(void)
+{
+    char env[VKD3D_PATH_MAX];
+
+    /* Opt-in probe for the FSR FG ML gate: the frame generation module looks
+     * up amdxc64.dll with GetModuleHandleA/W and never loads it itself. On
+     * non-AMD devices vkd3d does not load it, so a local shim placed in the
+     * prefix system32 would never be found. This only loads the DLL; every
+     * answer still comes from the shim. Default behaviour is unchanged. */
+    if (!vkd3d_get_env_var("VKD3D_LOAD_AMDXC", env, sizeof(env)))
+        return false;
+    return env[0] != '\0' && strcmp(env, "0") != 0;
+}
+
 static void d3d12_device_init_vendor_hacks(struct d3d12_device *device)
 {
     int rc = vkd3d_nv_shader_init(device);
@@ -3169,6 +3183,15 @@
             INFO("Loaded amdxc64.dll successfully.\n");
     }
 
+    if (!device->vendor_hacks.amdxc64 && vkd3d_load_amdxc_probe_enabled())
+    {
+        device->vendor_hacks.amdxc64 = LoadLibraryA("amdxc64.dll");
+        if (device->vendor_hacks.amdxc64)
+            INFO("Loaded amdxc64.dll for the ML FG probe (VKD3D_LOAD_AMDXC).\n");
+        else
+            WARN("VKD3D_LOAD_AMDXC is set but amdxc64.dll did not load.\n");
+    }
+
     if (device->device_info.properties2.properties.vendorID == VKD3D_VENDOR_ID_INTEL)
     {
         char sysdir[MAX_PATH], path[MAX_PATH];
